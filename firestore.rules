rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function signedInUid() {
      return signedIn() && request.auth.uid != null;
    }

    function isOwnerByEmail(emailField) {
      return signedIn() && request.auth.token.email != null && emailField == request.auth.token.email;
    }

    function isOwnerByUid(uidField) {
      return signedInUid() && uidField == request.auth.uid;
    }

    // Size/shape guards so open "create" endpoints cannot be used to flood the database
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    // True when the field is absent, or is a string no longer than max.
    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function validProfile(d) {
      return optString(d, 'name', 200)
        && optString(d, 'email', 320)
        && optString(d, 'phone', 50)
        && optString(d, 'avatar', 600000)
        && optString(d, 'status', 30)
        && optString(d, 'updatedAt', 64)
        && optString(d, 'deactivatedAt', 64)
        && (!('savedInterests' in d) || (d.savedInterests is list && d.savedInterests.size() <= 100))
        && (!('userLocation' in d) || d.userLocation is map);
    }

    function validSharedTrip(d) {
      return optString(d, 'id', 200)
        && optString(d, 'destination', 200)
        && optString(d, 'updatedAt', 64)
        && (!('plan' in d) || d.plan is map);
    }

    // True when the field is absent, or is a string or a number (string length capped).
    function optStringOrNumber(d, k, max) {
      return !(k in d) || (d[k] is number) || (d[k] is string && d[k].size() <= max);
    }

    // Shape and size limits for booking documents (UserBookings / Bookings)
    function validBooking(d) {
      return d.keys().hasOnly(['id', 'type', 'status', 'bookingRef', 'title', 'subtitle', 'checkIn', 'checkOut',
          'details', 'price', 'image', 'coordinates', 'userEmail', 'destination', 'createdAt'])
        && isShortString(d.userEmail, 320)
        && optString(d, 'id', 2000)
        && optString(d, 'type', 2000)
        && optString(d, 'status', 2000)
        && optString(d, 'bookingRef', 2000)
        && optString(d, 'title', 2000)
        && optString(d, 'subtitle', 2000)
        && optString(d, 'details', 20000)
        && optString(d, 'destination', 2000)
        && optString(d, 'checkIn', 64)
        && optString(d, 'checkOut', 64)
        && optString(d, 'createdAt', 64)
        && optString(d, 'image', 600000)
        && optStringOrNumber(d, 'price', 200)
        && (!('coordinates' in d) || d.coordinates == null || d.coordinates is map);
    }

    // Shape and size limits for favorite documents (UserFavorites)
    function validFavorite(d) {
      return d.keys().hasOnly(['userEmail', 'placeKey', 'id', 'name', 'title', 'description', 'image',
          'category', 'rating', 'addedAt', 'updatedAt'])
        && isShortString(d.userEmail, 320)
        && optString(d, 'placeKey', 2000)
        && optString(d, 'id', 2000)
        && optString(d, 'name', 2000)
        && optString(d, 'title', 2000)
        && optString(d, 'description', 20000)
        && optString(d, 'category', 2000)
        && optString(d, 'image', 600000)
        && optStringOrNumber(d, 'rating', 50)
        && optString(d, 'addedAt', 64)
        && optString(d, 'updatedAt', 64);
    }

    // 1. User Trips: Private to the trip creator (by email or UID)
    match /UserTrips/{docId} {
      allow read, delete: if isOwnerByEmail(resource.data.userEmail) || isOwnerByUid(resource.data.userId);

      // A trip is always stamped with the signed-in user's own email (the app never writes userId),
      // so nobody can plant a trip into another account or create trips without an email identity.
      // Only the fields the app writes are accepted.
      allow create: if isOwnerByEmail(request.resource.data.userEmail)
        && request.resource.data.keys().hasOnly(['userEmail', 'tripData', 'createdAt', 'updatedAt'])
        && request.resource.data.tripData is map
        && optString(request.resource.data, 'createdAt', 64)
        && optString(request.resource.data, 'updatedAt', 64);

      // Owners may change only the trip content. Ownership fields (userEmail, userId) are immutable.
      allow update: if (isOwnerByEmail(resource.data.userEmail) || isOwnerByUid(resource.data.userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripData', 'updatedAt'])
        && request.resource.data.tripData is map
        && optString(request.resource.data, 'updatedAt', 64);
    }

    // 2. User Profiles: Private to the authenticated user
    match /users/{userId} {
      allow read, delete: if signedInUid() && request.auth.uid == userId;

      // Only profile fields the app writes, with sane types and lengths. The avatar limit is generous
      // because web builds can store the picked image inline.
      allow create: if signedInUid() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'avatar', 'status', 'updatedAt', 'deactivatedAt', 'savedInterests', 'userLocation'])
        && validProfile(request.resource.data);

      allow update: if signedInUid() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'avatar', 'status', 'updatedAt', 'deactivatedAt', 'savedInterests', 'userLocation'])
        && validProfile(request.resource.data);
    }

    // 3. User Bookings: Private to the booking owner
    match /UserBookings/{bookingId} {
      allow read, delete: if isOwnerByEmail(resource.data.userEmail);
      allow create: if isOwnerByEmail(request.resource.data.userEmail)
        && validBooking(request.resource.data);
      allow update: if isOwnerByEmail(resource.data.userEmail)
        && request.resource.data.userEmail == resource.data.userEmail
        && validBooking(request.resource.data);
    }

    match /Bookings/{bookingId} {
      allow read, delete: if isOwnerByEmail(resource.data.userEmail);
      allow create: if isOwnerByEmail(request.resource.data.userEmail)
        && validBooking(request.resource.data);
      allow update: if isOwnerByEmail(resource.data.userEmail)
        && request.resource.data.userEmail == resource.data.userEmail
        && validBooking(request.resource.data);
    }

    // 4. Support Tickets: Anyone can create; users can ONLY read their own tickets
    match /SupportTickets/{ticketId} {
      // Guests may file tickets, but only with a bounded, well-formed payload
      allow create: if request.resource.data.keys().hasOnly(['category', 'message', 'userEmail', 'userId', 'platform', 'status', 'createdAt'])
        && isShortString(request.resource.data.message, 2000)
        && request.resource.data.message.size() > 0
        && isShortString(request.resource.data.category, 100)
        && isShortString(request.resource.data.userEmail, 320)
        && isShortString(request.resource.data.userId, 128)
        && request.resource.data.status == 'open'
        && (!signedIn() || request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'guest');
      allow read: if signedIn() && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
      // No client-side modification or deletion of support tickets
      allow update, delete: if false;
    }

    // 5. Shared Trips: Publicly readable (share links); only the authenticated owner can create/modify.
    // The client must stamp userId = auth.uid on create. Owner fields cannot be changed afterwards.
    match /SharedTrips/{tripId} {
      // Share links fetch ONE document by id, so single-document reads stay public.
      // Listing is limited to the owner's own documents (needed by account deletion), which
      // stops anyone from enumerating every shared trip and the owner emails inside them.
      allow get: if true;
      allow list: if signedInUid() && resource.data.userId == request.auth.uid;
      allow create: if signedInUid()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'destination', 'plan', 'updatedAt', 'userId'])
        && validSharedTrip(request.resource.data);
      allow update: if signedInUid()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'destination', 'plan', 'updatedAt'])
        && validSharedTrip(request.resource.data);
      allow delete: if signedInUid() && resource.data.userId == request.auth.uid;
    }

    // 5b. Favorites: private to the owner (synced by email, matching existing documents)
    match /UserFavorites/{favId} {
      allow read, delete: if isOwnerByEmail(resource.data.userEmail);
      allow create: if isOwnerByEmail(request.resource.data.userEmail)
        && validFavorite(request.resource.data);
      allow update: if isOwnerByEmail(resource.data.userEmail)
        && request.resource.data.userEmail == resource.data.userEmail
        && validFavorite(request.resource.data);
    }

    // 6. Telemetry & Crash Reports: App can log errors; NEVER readable or modifiable from client
    match /AppErrors/{errorId} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'componentStack', 'platform', 'timestamp'])
        && isShortString(request.resource.data.message, 1000)
        && isShortString(request.resource.data.stack, 2000)
        && isShortString(request.resource.data.componentStack, 2000);
      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
  }
}

