# Copy to .env.local (never committed) and fill in. See docs/ENVIRONMENTS.md.

# Which environment is this? development | staging | production
# (Unset: `expo start` = development, any built app/site = production.)
EXPO_PUBLIC_APP_ENV=development

# Backend (FastAPI). Required unless this is a production build.
# Local backend from a phone: use your computer's LAN address, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=

# Firebase project for this environment. Set ALL FOUR (the other three are optional):
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Escape hatch: knowingly use the LIVE backend and Firebase project from a non-production build.
# Anything you do then affects real users' data. Leave unset unless you mean it.
# EXPO_PUBLIC_USE_PRODUCTION_SERVICES=true
