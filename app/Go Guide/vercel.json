{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/trip/:id",
      "destination": "/trip"
    },
    {
      "source": "/((?!_expo|assets).*)",
      "destination": "/index.html"
    }
  ]
}
